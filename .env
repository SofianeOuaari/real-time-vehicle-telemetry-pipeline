# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_RAW_TOPIC=car-telemetry-raw
KAFKA_ENRICHED_TOPIC=car-telemetry-enriched

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Project
PROJECT_DIR=/home/sofiane/Desktop/MLOps/airflow_kafka_opentelemtry_elastic_search_langhchain
DOCKER_GID=999

# Storage Paths
PARQUET_OUTPUT_DIR=/opt/airflow/data/parquet
ANALYSIS_RESULTS_PATH=/opt/airflow/data/analysis_results
DUCKDB_PATH=/opt/airflow/data/telemetry.duckdb

# Generator Configuration
GENERATOR_NUM_VEHICLES=50
GENERATOR_INTERVAL_SECONDS=1
GENERATOR_ANOMALY_PROBABILITY=0.08
GENERATOR_RUN_DURATION=240

# Preprocessor Configuration
PREPROCESSOR_BATCH_SIZE=100
PREPROCESSOR_BATCH_TIMEOUT_MS=5000
PREPROCESSOR_RUN_DURATION=270

# Parquet Writer Configuration
PARQUET_MAX_BATCH_SIZE=10000
PARQUET_MAX_FLUSH_INTERVAL_SECONDS=300
PARQUET_COMPRESSION=snappy
PARQUET_WRITER_RUN_DURATION=300

# Monitoring
LOG_LEVEL=INFO
